APP_ENV=staging
DOMAIN=jobfit.example.com

AUTH_JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
AUTH_JWT_EXPIRE_MINUTES=1440
DEMO_USERNAME=demo_user
DEMO_PASSWORD=CHANGE_ME_STRONG_DEMO_PASSWORD
DEMO_ACCESS_TOKEN=CHANGE_ME_RANDOM_TOKEN
ALLOW_DEMO_TOKEN=false

LLM_API_KEY=CHANGE_ME_REAL_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

JOBFIT_DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://jobfit_app:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/jobfit_prod
REDIS_URL=redis://redis:6379/0

VECTOR_INDEX_PATH=/app/.cache/chroma
EMBEDDING_CACHE_PATH=/app/.cache/fastembed
VECTOR_COLLECTION_NAME=jobfit_resume_chunks_v1

LOG_LEVEL=INFO
LOG_FORMAT=json
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
DAILY_REQUEST_QUOTA=200
DAILY_TOKEN_QUOTA=200000

LLM_INPUT_PRICE_PER_1M=0
LLM_OUTPUT_PRICE_PER_1M=0
COST_CURRENCY=CNY
