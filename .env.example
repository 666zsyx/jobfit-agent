APP_ENV=development
AUTH_JWT_SECRET=dev-only-change-me-at-least-32-characters
AUTH_JWT_EXPIRE_MINUTES=1440
DEMO_USERNAME=demo_user
DEMO_PASSWORD=demo-password
DEMO_ACCESS_TOKEN=demo-token
ALLOW_DEMO_TOKEN=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
DATABASE_URL=postgresql+asyncpg://jobfit_app:CHANGE_ME@127.0.0.1:5432/jobfit_dev
REDIS_URL=redis://127.0.0.1:6379/0
JOBFIT_DB_PASSWORD=CHANGE_ME
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_PATH=.cache/fastembed
VECTOR_INDEX_PATH=.cache/chroma
VECTOR_COLLECTION_NAME=jobfit_resume_chunks_v1
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
LOG_LEVEL=INFO
LOG_FORMAT=json
LLM_INPUT_PRICE_PER_1M=0
LLM_OUTPUT_PRICE_PER_1M=0
COST_CURRENCY=USD
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
DAILY_REQUEST_QUOTA=200
DAILY_TOKEN_QUOTA=200000
